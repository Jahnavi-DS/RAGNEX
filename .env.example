# Server-side only. Never prefix with VITE_ — that would expose it to the browser bundle.
GROQ_API_KEY=

# Optional. Defaults to openai/gpt-oss-120b if unset.
GROQ_MODEL=

# --- TigerGraph / Savanna (GraphRAG) ---
# Server-side only. Never prefix with VITE_.
# Base URL of your TigerGraph Savanna workspace, e.g. https://my-workspace.i.tgcloud.io
TIGERGRAPH_HOST=

# Name of the graph GraphRAG should query.
TIGERGRAPH_GRAPH_NAME=

# Provide EITHER a pre-issued REST++ bearer token...
TIGERGRAPH_TOKEN=

# ...OR a secret (generated in Admin Portal > User Management), which will be
# exchanged for a token automatically via POST /gsql/v1/tokens.
TIGERGRAPH_SECRET=

# Optional. Lifetime (seconds) requested when exchanging TIGERGRAPH_SECRET
# for a token. Defaults to 2592000 (30 days, TigerGraph's own default).
TIGERGRAPH_TOKEN_LIFETIME_SECONDS=

# Optional. Name of the installed query GraphRAG calls. The live RAGNEX graph
# uses "event_neighborhood" (parameter: event_id STRING); the retriever resolves
# Event vertices before invoking it. Other query names use the generic contract
# (parameters: input STRING, depth INT; results: Vertices[], Edges[]).
TIGERGRAPH_QUERY_NAME=

# --- Agentic GraphRAG ---
# Optional. Maximum number of investigation iterations the agent may take
# before it is forced to stop and answer with whatever evidence it has.
# Defaults to 6. See src/server/agentic/agentic-orchestrator.ts.
AGENTIC_MAX_ITERATIONS=
